{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dotnet-nudge": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/scripts/run.cjs", "mcp"],
      "env": {
        "NUDGE_PLUGIN_DATA": "${PLUGIN_DATA}"
      }
    }
  }
}
